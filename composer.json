{
  "name": "wolxxx/certwatch",
  "description": "observe the validity of your ssl certificates",
  "minimum-stability": "stable",
  "version": "2.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "wolxXx",
      "email": "devops@wolxxx.de"
    }
  ],
  "support": {
    "email": "devops@wolxxx.de"
  },
  "config": {
    "secure-http": false
  },
  "autoload": {
    "psr-4": {
      "Certwatch\\": "src/"
    }
  },
  "require": {
    "php": "~8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "fzaninotto/faker": "*",
    "phpmailer/phpmailer": "*",
    "phpunit/phpunit": "*",
    "symfony/console": "*",
    "spatie/ssl-certificate": "*",
    "twig/twig": "*"
  },
  "scripts": {
    "runChecks": "php run.php",
    "runTests": "XDEBUG_MODE=coverage ./vendor/phpunit/phpunit/phpunit  --configuration test/phpunit.xml --coverage-html test/coverage --coverage-clover test/coverage/coverage.clover"
  }
}
