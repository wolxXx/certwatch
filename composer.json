{
  "name": "wolxxx/certwatch",
  "description": "observe the validity of your ssl certificates",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "wolxXx",
      "email": "devops@wolxxx.de"
    }
  ],
  "support": {
    "email": "devops@wolxxx.de"
  },
  "config": {
    "secure-http": false
  },
  "autoload": {
    "psr-4": {
      "Certwatch\\": "src/"
    }
  },
  "require": {
    "php": "~8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "fzaninotto/faker": "@stable",
    "phing/phing": "@stable",
    "phpmailer/phpmailer": "@stable",
    "phpunit/phpunit": "@stable",
    "symfony/console": "@stable",
    "spatie/ssl-certificate": "@stable",
    "twig/twig": "@stable"
  }
}
